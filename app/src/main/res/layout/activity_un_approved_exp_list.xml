<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5sp"
        android:text="Un-approved Expenses"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:background="@color/green"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10sp"
        android:layout_alignParentTop="true"
        android:id="@+id/tvHeader"/>
    <!-- FILTERS -->
    <LinearLayout
        android:id="@+id/llFilters"
        android:layout_below="@id/tvHeader"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="8dp">
            <!-- Date From -->
            <EditText
                android:id="@+id/etFromDateU"
                android:hint="From Date"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
            <!-- Date To -->
            <EditText
                android:id="@+id/etToDateU"
                android:hint="To Date"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <!-- Godowns -->
            <Spinner
                android:id="@+id/spGodownU"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>

            <!-- Select Expense -->
            <Spinner
                android:id="@+id/spExpenseTypeU"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:background="@drawable/rounded_input"/>
        </LinearLayout>
        <!-- Search -->
        <Button
            android:id="@+id/btnSearchU"
            android:text="Search"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="GetExpensesReport"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:id="@+id/llButtons"
        android:orientation="horizontal"
        android:weightSum="5">
        <!-- Search -->
        <Button
            android:id="@+id/btnSelect"
            android:text="Select All"
            android:layout_width="0dp"
            android:layout_weight="1.8"
            android:layout_height="wrap_content"/>
        <View
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"/>
        <!-- Search -->
        <Button
            android:id="@+id/btnApprove"
            android:text="Approve Selected"
            android:layout_width="0dp"
            android:layout_weight="2.4"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <!-- LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExpensesU"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:layout_below="@id/llFilters"
        android:layout_above="@id/llButtons"/>

</RelativeLayout>