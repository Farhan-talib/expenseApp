<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5sp"
        android:text="Expense Report"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:background="@color/green"
        android:layout_marginTop="15sp"
        android:layout_marginBottom="10sp"/>
    <!-- FILTERS -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="8dp">
            <!-- Date From -->
            <EditText
                android:id="@+id/etFromDate"
                android:hint="From Date"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
            <!-- Date To -->
            <EditText
                android:id="@+id/etToDate"
                android:hint="To Date"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:id="@+id/llFilterSpinner">
            <!-- Godowns -->
            <Spinner
                android:id="@+id/spGodown"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
            <!-- Status -->
            <Spinner
                android:id="@+id/spStatus"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>

            <!-- Select Expense -->
            <Spinner
                android:id="@+id/spExpenseType"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:background="@drawable/rounded_input"/>
        </LinearLayout>
        <!-- Search -->
        <Button
            android:id="@+id/btnSearch"
            android:text="Search"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="GetExpensesReport"/>

    </LinearLayout>

    <!-- LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExpenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDownloadPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="90dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Download PDF"
        android:src="@drawable/ic_pdf"
        android:tooltipText="Download PDF Report"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDownloadExcel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Download Excel"
        android:src="@drawable/ic_excel"
        android:tooltipText="Download Excel Report"/>
</FrameLayout>