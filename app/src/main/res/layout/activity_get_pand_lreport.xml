<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GetPandLReport"
    android:background="@color/white"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5sp"
            android:text="P &amp; L Report"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@color/green"
            android:layout_marginTop="15sp"
            android:layout_marginBottom="5sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">
            <!-- Godowns -->
            <Spinner
                android:id="@+id/spPLGodown"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
            <!-- Date From -->
            <EditText
                android:id="@+id/etPLFromDate"
                android:hint="From Date"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
            <!-- Date To -->
            <EditText
                android:id="@+id/etPLToDate"
                android:hint="To Date"
                android:focusable="false"
                android:drawableEnd="@android:drawable/ic_menu_today"
                android:layout_width="0sp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:padding="5sp"
                android:background="@drawable/rounded_input"/>
        </LinearLayout>
        <!-- Search -->
        <Button
            android:id="@+id/btnPLSearch"
            android:text="Search"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="GetPLReport"/>
        <!-- LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPL"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDownloadPLPdf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="90dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Download PDF"
        android:src="@drawable/ic_pdf"
        android:tooltipText="Download PDF Report"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDownloadPLExcel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Download Excel"
        android:src="@drawable/ic_excel"
        android:tooltipText="Download Excel Report"/>
</FrameLayout>