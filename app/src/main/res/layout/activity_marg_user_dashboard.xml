<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".MargUserDashboard">

    <!-- 👤 USER DETAILS CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/txtMargUserID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User ID: 123"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtMargUserName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User Name: Farhan"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- ⏰ LIVE CLOCK -->
    <TextClock
        android:id="@+id/txtMargClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="dd MMM yyyy  hh:mm:ss a"
        android:format24Hour="dd MMM yyyy  HH:mm:ss"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- 📌 ACTION BUTTONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnNewMargEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark Marg Entry Done"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnViewMargReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Expense Report"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#388E3C"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnMargLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>