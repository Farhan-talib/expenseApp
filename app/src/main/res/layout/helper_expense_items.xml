<!-- item_expense.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:orientation="horizontal"
    android:weightSum="10"
    android:background="#FFFFFF"
    android:layout_marginBottom="0dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/llExpenses">
    <CheckBox
        android:id="@+id/chkSelect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:visibility="gone"/>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="10"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:id="@+id/llInner">

        <TextView android:id="@+id/txtName"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView android:id="@+id/txtGodown"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <TextView android:id="@+id/txtAmount"
                android:textColor="#D32F2F"
                android:layout_width="0dp"
                android:layout_weight="0.9"
                android:layout_height="wrap_content"/>

            <TextView android:id="@+id/txtDate"
                android:layout_width="0dp"
                android:layout_weight="1.9"
                android:layout_height="wrap_content"/>

            <TextView android:id="@+id/txtExpenseBy"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="wrap_content"/>

        </LinearLayout>
        <TextView
            android:id="@+id/tvViewBill"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View Upload"
            android:layout_marginBottom="5dp"
            android:background="#1976D2"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:padding="5sp" />
    </LinearLayout>
</LinearLayout>