<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 👤 ADMIN DETAILS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="4dp"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="20dp">

        <TextView
            android:id="@+id/txtAdminID"
            android:text="Admin ID: 0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtAdminName"
            android:text="Admin Name"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- ⏰ CLOCK -->
    <TextClock
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:format12Hour="dd MMM yyyy  hh:mm:ss a"
        android:format24Hour="dd MMM yyyy  HH:mm:ss"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- 🔴 TODAY'S EXPENSE -->
    <TextView
        android:id="@+id/txtTodayExpense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's Expense: ₹ 0.00"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#D32F2F"
        android:gravity="center"/>

    <!-- 🟢 TODAY'S INCOME -->
    <TextView
        android:id="@+id/txtTodayIncome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's Income: ₹ 0.00"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#388E3C"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- 🟢 TODAY'S STATEMENT -->
    <TextView
        android:id="@+id/txtTodayStatement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Today's Income: ₹ 0.00"
        android:textSize="26sp"
        android:textStyle="bold"
        android:background="#388E3C"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- 🔘 BUTTONS -->
    <Button
        android:id="@+id/btnAddIncome"
        android:text="Add Income"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnIncomeReport"
        android:text="View Income Report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnApproveExpenses"
        android:text="Approve Expenses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnExpenseReport"
        android:text="Get Expense Report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnPLReport"
        android:text="Get P &amp; L Report"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:text="Logout"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>